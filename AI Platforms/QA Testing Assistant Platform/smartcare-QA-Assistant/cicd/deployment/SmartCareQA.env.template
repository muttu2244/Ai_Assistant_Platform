# SmartCare QA Assistant deployment template
# Copy this file to .env in the package root and replace placeholder values.

# Application
APP_NAME=SmartCare QA Assistant
APP_ENV=production
LOG_LEVEL=INFO
ASSISTANT_MODE=balanced
RETRIEVAL_FIRST_TESTCASE=true

# Azure DevOps
ADO_ORG_URL=https://dev.azure.com/your-organization
ADO_PROJECT=your-project
ADO_PAT=replace-with-pat
ADO_API_VERSION=7.1

# Azure AI Foundry / Azure OpenAI
AI_FOUNDRY_ENDPOINT=https://your-foundry-endpoint
AI_FOUNDRY_API_KEY=replace-with-key-or-use-entra
AI_FOUNDRY_DEPLOYMENT=gpt-4o
AI_FOUNDRY_API_VERSION=2024-02-01
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# Presidio
# Use local mode for non-container deployments unless a shared Presidio service exists.
PRESIDIO_BACKEND=local
PRESIDIO_ANALYZER_URL=http://localhost:3000
PRESIDIO_ANONYMIZER_URL=http://localhost:3001

# Key Vault
KEY_VAULT_URL=

# Blob Storage
BLOB_ACCOUNT_URL=
BLOB_CONTAINER_GENERATED=generated-artifacts

# Redis
REDIS_HOST=
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_SSL=true
REDIS_TTL_SECONDS=3600

# Cosmos DB
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=smartcare_qa
COSMOS_CONTAINER_CHAT=chat_history
COSMOS_CONTAINER_PROMPTS=prompt_templates

# SQL
SQL_CONNECTION_STRING=

# AI Search
AI_SEARCH_ENDPOINT=
AI_SEARCH_API_KEY=
AI_SEARCH_INDEX_TESTCASES=testcases-index

# Service Bus
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_GENERATION=generation-requests

# Application Insights
APPINSIGHTS_CONNECTION_STRING=

# Entra ID
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_SCOPES=https://graph.microsoft.com/.default

# Content Safety
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_API_KEY=

# APIM
APIM_BASE_URL=