# SmartCare QA Assistant — Environment Variables Template
# Copy to .env and fill in real values (pulled from Azure Key Vault in prod)

# App
APP_ENV=development
LOG_LEVEL=INFO

# Azure DevOps
ADO_ORG_URL=https://dev.azure.com/StreamlineHealthcareSolutions/
ADO_PROJECT=SmartCare
ADO_PAT="1OmwGSeiDwX3miZIWfwXGgf92yEXo5vYKwtpAz3LSjRH59fhAeXEJQQJ99CBACAAAAAGBF1EAAASAZDO1bgb"

# Azure AI Foundry / GPT-4o
AI_FOUNDRY_ENDPOINT=https://YOUR_HUB.openai.azure.com/
AI_FOUNDRY_API_KEY=YOUR_KEY
AI_FOUNDRY_DEPLOYMENT=gpt-4o

# Microsoft Presidio (local containers or deployed)
PRESIDIO_ANALYZER_URL=http://localhost:3000
PRESIDIO_ANONYMIZER_URL=http://localhost:3001

# Azure Key Vault
KEY_VAULT_URL=https://YOUR_KV.vault.azure.net/

# Azure Blob Storage
BLOB_ACCOUNT_URL=https://YOUR_STORAGE.blob.core.windows.net
BLOB_CONTAINER_GENERATED=generated-artifacts

# Azure Cache for Redis
REDIS_HOST=YOUR_REDIS.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_SSL=true

# Azure Cosmos DB
COSMOS_ENDPOINT=https://YOUR_COSMOS.documents.azure.com:443/
COSMOS_KEY=YOUR_COSMOS_KEY

# Azure SQL
SQL_CONNECTION_STRING=mssql+pyodbc://user:pass@server/db?driver=ODBC+Driver+18+for+SQL+Server

# Azure AI Search
AI_SEARCH_ENDPOINT=https://YOUR_SEARCH.search.windows.net
AI_SEARCH_API_KEY=YOUR_SEARCH_KEY

# Azure Service Bus
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://YOUR_BUS.servicebus.windows.net/;...

# Azure Application Insights
APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# Entra ID
ENTRA_TENANT_ID=YOUR_TENANT_ID
ENTRA_CLIENT_ID=YOUR_CLIENT_ID
ENTRA_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Azure Content Safety
CONTENT_SAFETY_ENDPOINT=https://YOUR_CS.cognitiveservices.azure.com/
CONTENT_SAFETY_API_KEY=YOUR_CS_KEY
